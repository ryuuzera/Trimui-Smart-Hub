<UserControl x:Class="TrimuiSmartHub.Application.Views.BiosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:vm="clr-namespace:TrimuiSmartHub.Application.ViewModels"
             xmlns:bios="clr-namespace:TrimuiSmartHub.Core.Bios;assembly=TrimuiSmartHub.Core"
             xmlns:l="clr-namespace:TrimuiSmartHub.Application.Localization"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:BiosViewModel}">

    <UserControl.Resources>
        <Style x:Key="StateText" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding Converter={StaticResource EnumLoc}}" />
            <Setter Property="Foreground" Value="{StaticResource Hub.Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Static bios:BiosState.Ok}">
                    <Setter Property="Foreground" Value="{StaticResource Hub.Ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static bios:BiosState.WrongHash}">
                    <Setter Property="Foreground" Value="{StaticResource Hub.Warn}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource Hub.PrimaryButton}" Tag="FilePlusOutline" Content="{l:Loc BiosAdd}" Command="{Binding AddFilesCommand}" />
                <Button Style="{StaticResource Hub.Button}" Tag="Upload" Content="{l:Loc BiosSync}" Command="{Binding SyncBiosCommand}" IsEnabled="{Binding Monitor.IsConnected}" />
                <Button Style="{StaticResource Hub.Button}" Tag="Refresh" Content="{l:Loc Refresh}" Command="{Binding CheckCommand}" />
                <Button Style="{StaticResource Hub.Button}" Tag="FolderOpenOutline" ToolTip="{l:Loc OpenFolder}" Command="{Binding OpenFolderCommand}" Margin="0" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{l:Loc NavBios}" Style="{StaticResource Hub.PageTitle}" />
                <TextBlock Text="{l:Loc BiosSubtitle}" Style="{StaticResource Hub.Subtitle}" />
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource Hub.SectionTitle}" />

        <Grid>
            <Border Style="{StaticResource Hub.CardBorder}" Padding="4">
                <ListView ItemsSource="{Binding Rows}" Style="{StaticResource Hub.ListView}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{l:Loc ColumnPlatform}" Width="200" DisplayMemberBinding="{Binding Platform}" />
                            <GridViewColumn Header="{l:Loc ColumnFile}" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:BiosRow}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding File}" Foreground="{StaticResource Hub.TextStrong}" />
                                            <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{StaticResource Hub.Muted}" Visibility="{Binding Note, Converter={StaticResource Visible}}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{l:Loc BiosRequired}" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:BiosRow}">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{l:Loc BiosOptional}" />
                                                    <Setter Property="Foreground" Value="{StaticResource Hub.Muted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Required}" Value="True">
                                                            <Setter Property="Text" Value="{l:Loc BiosRequired}" />
                                                            <Setter Property="Foreground" Value="{StaticResource Hub.TextStrong}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{l:Loc BiosInLibrary}" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:BiosRow}">
                                        <TextBlock DataContext="{Binding Library}" Style="{StaticResource StateText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{l:Loc BiosOnDevice}" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:BiosRow}">
                                        <TextBlock DataContext="{Binding Device}" Style="{StaticResource StateText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
            <mah:ProgressRing IsActive="{Binding IsLoading}" Width="40" Height="40" />
        </Grid>
    </DockPanel>
</UserControl>
