<UserControl x:Class="TrimuiSmartHub.Application.Views.ScrapeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:vm="clr-namespace:TrimuiSmartHub.Application.ViewModels"
             xmlns:games="clr-namespace:TrimuiSmartHub.Core.Games;assembly=TrimuiSmartHub.Core"
             xmlns:l="clr-namespace:TrimuiSmartHub.Application.Localization"
             xmlns:infra="clr-namespace:TrimuiSmartHub.Application.Infrastructure"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:ScrapeViewModel}">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="{l:Loc NavBoxarts}" Style="{StaticResource Hub.PageTitle}" />
            <TextBlock Text="{l:Loc ScrapeSubtitle}" Style="{StaticResource Hub.Subtitle}" />
        </StackPanel>

        <!-- Options -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Hub.CardBorder}" Margin="0,0,0,12">
            <WrapPanel>
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="{l:Loc ScrapeSourceLabel}" Style="{StaticResource Hub.Subtitle}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{l:Loc ScrapeSourceLibrary}" IsChecked="{Binding IsDeviceSource, Converter={StaticResource Not}}" Margin="0,0,16,0" />
                        <RadioButton Content="{l:Loc ScrapeSourceDevice}" IsChecked="{Binding IsDeviceSource}" IsEnabled="{Binding Monitor.IsConnected}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="{l:Loc ScrapeKindLabel}" Style="{StaticResource Hub.Subtitle}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Width="160">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumLoc}}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel VerticalAlignment="Bottom" Margin="0,0,32,4">
                    <CheckBox Content="{l:Loc ScrapeOverwrite}" IsChecked="{Binding Overwrite}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource Hub.Button}" Tag="CheckboxMultipleMarkedOutline" Content="{l:Loc SelectAll}" Command="{Binding SelectAllCommand}" />
                    <Button Style="{StaticResource Hub.PrimaryButton}" Tag="CloudDownloadOutline" Content="{l:Loc ScrapeStart}" Command="{Binding StartCommand}" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="{Binding LastResult}" Style="{StaticResource Hub.Body}" Foreground="{StaticResource Hub.TextStrong}" Margin="0,0,0,12"
                   Visibility="{Binding LastResult, Converter={StaticResource Visible}}" />

        <!-- Uncertain matches -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Hub.CardBorder}" Margin="0,12,0,0" MaxHeight="300"
                Visibility="{Binding Review.Count, Converter={StaticResource Visible}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Hub.PrimaryButton}" Tag="Check" Content="{l:Loc ScrapeApplyReview}" Command="{Binding ApplyReviewCommand}" Margin="0" />
                    <StackPanel>
                        <TextBlock Text="{l:Loc ScrapeReviewTitle}" Style="{StaticResource Hub.SectionTitle}" Margin="0" />
                        <TextBlock Text="{l:Loc ScrapeReviewText}" Style="{StaticResource Hub.Subtitle}" />
                    </StackPanel>
                </DockPanel>
                <ListView ItemsSource="{Binding Review}" Style="{StaticResource Hub.ListView}">
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ReviewItem}">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Rom.Name}" Foreground="{StaticResource Hub.TextStrong}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding PlatformName}" FontSize="11" Foreground="{StaticResource Hub.Muted}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Suggestions}" SelectedItem="{Binding Chosen}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type games:TitleMatch}">
                                            <TextBlock>
                                                <Run Text="{Binding Candidate, Mode=OneWay}" /> <Run Text="{Binding Score, Mode=OneWay, StringFormat=({0:P0})}" Foreground="{StaticResource Hub.Muted}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2" Style="{StaticResource Hub.Button}" Content="{l:Loc Skip}" Margin="8,0,0,0"
                                        Command="{Binding DataContext.SkipReviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </Border>

        <!-- Platforms -->
        <Grid>
            <mah:ProgressRing IsActive="{Binding IsLoading}" Width="40" Height="40" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Targets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ScrapeTarget}">
                            <ToggleButton IsChecked="{Binding IsSelected}" Width="150" Height="140" Margin="0,0,10,10" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Root" Background="{StaticResource Hub.Card}" BorderBrush="{StaticResource Hub.Border}" BorderThickness="2" CornerRadius="10" Padding="8">
                                            <StackPanel VerticalAlignment="Center">
                                                <Image Source="{Binding Platform.Id, Converter={StaticResource PlatformIcon}}" Height="54" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock Text="{Binding Platform.Name}" Foreground="{StaticResource Hub.TextStrong}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                                                <TextBlock FontSize="11" Foreground="{StaticResource Hub.Muted}" TextAlignment="Center">
                                                    <Run Text="{Binding Roms.Count, Mode=OneWay}" /> <Run Text="{l:Loc Games}" /> · <Run Text="{Binding Missing, Mode=OneWay}" /> <Run Text="{l:Loc ScrapeMissing}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Hub.CardHover}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Hub.Accent}" />
                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Hub.CardHover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="{l:Loc ScrapeNothing}" Style="{StaticResource Hub.Body}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Visibility>
                    <MultiBinding Converter="{x:Static infra:ViewHelpers.EmptyAndIdle}">
                        <Binding Path="Targets.Count" />
                        <Binding Path="IsLoading" />
                    </MultiBinding>
                </TextBlock.Visibility>
            </TextBlock>
        </Grid>
    </DockPanel>
</UserControl>
