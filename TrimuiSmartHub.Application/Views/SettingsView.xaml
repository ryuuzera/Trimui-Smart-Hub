<UserControl x:Class="TrimuiSmartHub.Application.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:vm="clr-namespace:TrimuiSmartHub.Application.ViewModels"
             xmlns:l="clr-namespace:TrimuiSmartHub.Application.Localization"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="{l:Loc NavSettings}" Style="{StaticResource Hub.PageTitle}" Margin="0,0,0,16" />

            <Border Style="{StaticResource Hub.CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{l:Loc SettingsLibrary}" Style="{StaticResource Hub.SectionTitle}" />
                    <TextBlock Text="{l:Loc SettingsLibraryHint}" Style="{StaticResource Hub.Subtitle}" Margin="0,0,0,8" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Hub.Button}" Tag="FolderOutline" Content="{l:Loc Browse}" Command="{Binding BrowseLibraryCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding LibraryPath, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Hub.CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{l:Loc NavSaves}" Style="{StaticResource Hub.SectionTitle}" />
                    <CheckBox Content="{l:Loc SettingsAutoBackup}" IsChecked="{Binding AutoBackupSaves}" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:Loc SettingsKeepLatest}" Style="{StaticResource Hub.Body}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <mah:NumericUpDown Value="{Binding BackupKeepLatest}" Minimum="1" Maximum="1000" Width="110" Margin="0,0,24,0" />
                        <TextBlock Text="{l:Loc SettingsKeepMonthly}" Style="{StaticResource Hub.Body}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <mah:NumericUpDown Value="{Binding BackupKeepMonthly}" Minimum="0" Maximum="120" Width="110" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Hub.CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{l:Loc SettingsGeneral}" Style="{StaticResource Hub.SectionTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{l:Loc SettingsLanguage}" Style="{StaticResource Hub.Body}" VerticalAlignment="Center" Width="200" />
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" DisplayMemberPath="Name" Width="240" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{l:Loc SettingsImageKind}" Style="{StaticResource Hub.Body}" VerticalAlignment="Center" Width="200" />
                        <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding ImageKind}" Width="240">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumLoc}}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <CheckBox Content="{l:Loc SettingsVerifyContent}" IsChecked="{Binding SyncVerifyContent}" Margin="0,0,0,8" />
                    <CheckBox Content="{l:Loc SettingsCheckUpdates}" IsChecked="{Binding CheckForUpdates}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                <Button Style="{StaticResource Hub.PrimaryButton}" Tag="ContentSave" Content="{l:Loc Save}" Command="{Binding SaveCommand}" />
                <TextBlock Text="{Binding SavedMessage}" Foreground="{StaticResource Hub.Ok}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <Border Style="{StaticResource Hub.CardBorder}">
                <StackPanel>
                    <TextBlock Text="{l:Loc SettingsAbout}" Style="{StaticResource Hub.SectionTitle}" />
                    <TextBlock Text="{l:Loc SettingsAboutText}" Style="{StaticResource Hub.Body}" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Hub.Button}" Tag="Github" Content="GitHub" Command="{Binding OpenProjectCommand}" />
                        <Button Style="{StaticResource Hub.Button}" Tag="TextBoxOutline" Content="{l:Loc SettingsLogs}" Command="{Binding OpenLogsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
