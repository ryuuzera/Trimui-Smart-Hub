<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <!-- Palette (kept from the original design). -->
    <Color x:Key="Hub.Color.Background1">#2C3E50</Color>
    <Color x:Key="Hub.Color.Background2">#1B2A3D</Color>

    <SolidColorBrush x:Key="Hub.Panel" Color="#22384F" />
    <SolidColorBrush x:Key="Hub.Card" Color="#1F354A" />
    <SolidColorBrush x:Key="Hub.CardHover" Color="#2D5470" />
    <SolidColorBrush x:Key="Hub.Border" Color="#33506A" />
    <SolidColorBrush x:Key="Hub.Accent" Color="#3D8FBF" />
    <SolidColorBrush x:Key="Hub.AccentHover" Color="#4AA3D6" />
    <SolidColorBrush x:Key="Hub.Text" Color="#AAB8C2" />
    <SolidColorBrush x:Key="Hub.TextStrong" Color="#E8EEF2" />
    <SolidColorBrush x:Key="Hub.Muted" Color="#7F8C99" />
    <SolidColorBrush x:Key="Hub.Ok" Color="#6CC070" />
    <SolidColorBrush x:Key="Hub.Warn" Color="#E0A83A" />
    <SolidColorBrush x:Key="Hub.Error" Color="#E06C66" />

    <LinearGradientBrush x:Key="Hub.WindowBackground" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="{StaticResource Hub.Color.Background1}" />
        <GradientStop Color="{StaticResource Hub.Color.Background2}" Offset="0.5" />
    </LinearGradientBrush>

    <!-- Text -->
    <Style x:Key="Hub.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Hub.TextStrong}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="Hub.Subtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Hub.Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Hub.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Hub.TextStrong}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Hub.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Hub.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Containers -->
    <Style x:Key="Hub.CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Hub.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Hub.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="Hub.Banner" TargetType="Border">
        <Setter Property="Background" Value="#33E0A83A" />
        <Setter Property="BorderBrush" Value="{StaticResource Hub.Warn}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- Buttons. The icon is taken from Tag (a PackIconMaterialKind name). -->
    <Style x:Key="Hub.Button" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Hub.TextStrong}" />
        <Setter Property="Background" Value="{StaticResource Hub.Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Hub.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <icons:PackIconMaterial x:Name="Icon" Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Hub.CardHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Hub.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Hub.Button}">
        <Setter Property="Background" Value="{StaticResource Hub.Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Hub.Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Hub.LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Hub.Accent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Side navigation -->
    <Style x:Key="Hub.NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Hub.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="8" Padding="12,9">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#1A3142" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Hub.CardHover}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lists -->
    <Style x:Key="Hub.ListView" TargetType="ListView" BasedOn="{StaticResource MahApps.Styles.ListView}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Hub.Text}" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Style.Resources>
            <Style TargetType="ListViewItem" BasedOn="{StaticResource MahApps.Styles.ListViewItem}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource Hub.Text}" />
            </Style>
        </Style.Resources>
    </Style>

    <Style TargetType="ProgressBar" BasedOn="{StaticResource MahApps.Styles.ProgressBar}">
        <Setter Property="Foreground" Value="{StaticResource Hub.Accent}" />
        <Setter Property="Background" Value="#1AFFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="RadioButton" BasedOn="{StaticResource MahApps.Styles.RadioButton}">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Plain list items blend with the cards instead of MahApps' default dark rows. -->
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MahApps.Styles.ListBoxItem}">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="Hub.StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
</ResourceDictionary>
